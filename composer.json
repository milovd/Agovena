{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "agovena/agovena",
    "type": "project",
    "description": "Open-source modular commerce platform.",
    "keywords": ["agovena", "commerce", "laravel", "self-hosted"],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "barryvdh/laravel-dompdf": "3.1.2",
        "composer/semver": "^3.4",
        "laravel/framework": "^13.8",
        "laravel/sanctum": "^4.3",
        "laravel/tinker": "^3.0",
        "livewire/livewire": "^4.4",
        "mollie/mollie-api-php": "^3.13",
        "spatie/laravel-permission": "^6.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.0",
        "laravel/pail": "^1.2.5",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "phpunit/phpunit": "^12.5.12"
    },
    "autoload": {
            "files": [
                "app/helpers.php"
            ],
            "psr-4": {
                "App\\": "app/",
                "Database\\Factories\\": "database/factories/",
                "Database\\Seeders\\": "database/seeders/",
                "Agovena\\Modules\\Inventory\\": "modules/inventory/src/",
                "Agovena\\Modules\\Shipping\\": "modules/shipping/src/",
                "Agovena\\Modules\\Digital\\": "modules/digital/src/",
                "Agovena\\Modules\\Subscriptions\\": "modules/subscriptions/src/",
                "Agovena\\Modules\\Provisioning\\": "modules/provisioning/src/",
                "Agovena\\Modules\\Events\\": "modules/events/src/",
                "Agovena\\Extensions\\ManualPayment\\": "extensions/manual-payment/src/",
                "Agovena\\Extensions\\Mollie\\": "extensions/mollie/src/",
                "Agovena\\Extensions\\Pterodactyl\\": "extensions/pterodactyl/src/",
                "Agovena\\Extensions\\Postnl\\": "extensions/postnl/src/"
            }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install --ignore-scripts",
            "npm run build"
        ],
        "test": [
            "@php artisan config:clear --ansi @no_additional_args",
            "@php artisan test"
        ],
        "analyse": [
            "@php vendor/bin/phpstan analyse --memory-limit=1G"
        ],
        "lint": [
            "@php vendor/bin/pint --test"
        ],
        "format": [
            "@php vendor/bin/pint"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "platform": {
            "php": "8.3.0"
        },
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
