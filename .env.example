# Agovena environment template
# Copy to `.env` for local use. Never commit real secrets.

APP_NAME=Agovena
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Native production: APP_URL=https://shop.example.com
# Behind Nginx/HTTPS, set APP_URL to the public https origin.
# Do not set TRUSTED_PROXIES=* unless the proxy is fully trusted.
# TRUSTED_PROXIES=10.0.0.1

# Redis is optional. Database/file drivers are the supported single-host baseline.
# QUEUE_CONNECTION=database
# CACHE_STORE=database
# SESSION_DRIVER=file

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=agovena
DB_USERNAME=agovena
DB_PASSWORD=

# Local/dev alternative: DB_CONNECTION=sqlite

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
# SESSION_SECURE_COOKIE=true  # set when serving over HTTPS
# SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# Recommended for production: redis (cache, queue, session)
# REDIS_CLIENT=phpredis
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Optional: force-enable local development instant checkout payment (never in production)
# AGOVENA_DEV_INSTANT_PAY=true

# Privileged Admin users must enable TOTP. Customers are not forced.
# AGOVENA_PRIVILEGED_2FA=true
# AGOVENA_PASSWORD_TIMEOUT=900

# HTTP security headers. Override CSP only if a Theme needs extra hosts.
# AGOVENA_SECURITY_HEADERS=true
# AGOVENA_CSP=
# AGOVENA_HSTS=true
# AGOVENA_FRAME_OPTIONS=DENY
# AGOVENA_REFERRER_POLICY=strict-origin-when-cross-origin

VITE_APP_NAME="${APP_NAME}"
